# Copy thành .env (cùng thư mục với docker-compose.yml) và sửa giá trị
DOCKERHUB_USER=your-dockerhub-username
TAG=latest
# Link chia sẻ (bỏ trống = mặc định): KB tối đa/dự án nén, link mới/giờ/IP, tổng dung lượng MB,
# đầy thì xoá link lâu không mở (1) hay từ chối (0), xoá link không mở sau N ngày (0 = không xoá)
#SHARE_MAX_KB=64
#SHARE_RATE=30
#SHARE_QUOTA_MB=1024
#SHARE_EVICT=1
#SHARE_TTL_DAYS=365
